	(text "Voltage on TEMP must be between 45% to 80% of supply voltage VIN to enable charging\n\nNTC impedance at 25C is 10k, B constant 25/50 is 3950K, so impedance at 50C is ~3.6k and 33.6k at 0C.\n\n45% of VIN = 2.25V\n80% of VIN = 4V\n\nA 5.1k resistor at R4 will result in 2.1V at 50C and 4.0V at 10C to disable charging.\n\n"
		(exclude_from_sim no)
		(at 92.964 117.094 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "43bbb273-1125-4860-9884-ec73a307a9e3")
	)
